# Porta da API
PORT=3001

# Postgres corporativo (role de login que herda de portal_oportunidades_api)
DATABASE_URL=postgres://portal_opp_local:postgres@localhost:55432/portal

# Projeto Supabase (GoTrue + Storage) — mesmo projeto das demais micro-apps
SUPABASE_URL=https://<project-ref>.supabase.co
# Segredo HS256 do projeto: valida os JWTs emitidos pelo GoTrue (SSO)
SUPABASE_JWT_SECRET=troque-me
# Usada SOMENTE no backend para URLs assinadas do Storage — nunca no front
SUPABASE_SERVICE_ROLE_KEY=

# Storage
STORAGE_BUCKET=opp-documents

# Política de upload (RN-011)
UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_EXT=pdf,docx,xlsx,pptx,png,jpg,jpeg,zip

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# E-mail (opcional em dev; sem SMTP_HOST as notificações ficam só internas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=portal-oportunidades@xptoinc.com.br
